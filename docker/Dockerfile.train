# CUDA training image for Azure ML GPU compute (A100 primary, T4 fallback).
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt requirements-gpu.txt ./
RUN pip install --no-cache-dir -r requirements-gpu.txt

COPY minigpt/ minigpt/
COPY configs/ configs/
COPY TinyStories-1000.txt ./

# No ENTRYPOINT/CMD: the Azure ML job supplies the full invocation via its
# `command` field (prepare, then train — see .github/workflows/train.yml),
# which is the standard AML pattern and lets one image serve every config.
